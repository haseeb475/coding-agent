# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored. Never commit real API keys.

# ── LLM provider ─────────────────────────────────────────────────────────────
# "openai" = any OpenAI Chat Completions-compatible API (default)
# "azure"  = Azure OpenAI Service
LLM_PROVIDER=openai

# API key (required). For local servers that ignore it (Ollama, LM Studio,
# vLLM without auth) use any placeholder, e.g. "local".
# Falls back to OPENAI_API_KEY (openai) / AZURE_OPENAI_API_KEY (azure).
LLM_API_KEY=your_api_key_here

# Model name (required). For Azure, this is your deployment name.
LLM_MODEL=gpt-4o-mini

# Base URL of the API. Leave unset for api.openai.com.
# LLM_BASE_URL=https://api.openai.com/v1

# Optional cheaper/faster model used for planning, exploration and read-only
# "ask" chats. Unset = always use LLM_MODEL.
# LLM_MODEL_LIGHT=

# Request timeout in seconds (default 600). Agent steps can be slow on large prompts.
# LLM_TIMEOUT=600

# Total attempts per request, including retries of transient errors such as
# 429/5xx/timeouts (default 3).
# LLM_MAX_ATTEMPTS=3

# Extra HTTP headers as a JSON object, e.g. for OpenRouter attribution.
# LLM_EXTRA_HEADERS={"HTTP-Referer": "https://example.com", "X-Title": "coding-agent"}

# ── Example provider settings (uncomment one block) ─────────────────────────
# OpenRouter
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
# Ollama (run `ollama serve`, then `ollama pull <model>`)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=local
#   LLM_MODEL=qwen2.5-coder:14b
# vLLM / LM Studio / other self-hosted OpenAI-compatible servers
#   LLM_BASE_URL=http://localhost:8001/v1
#   LLM_API_KEY=local
#   LLM_MODEL=<model name served by the server>
# Azure OpenAI
#   LLM_PROVIDER=azure
#   LLM_BASE_URL=https://<resource-name>.openai.azure.com
#   LLM_MODEL=<deployment-name>
#   AZURE_OPENAI_API_VERSION=2024-10-21

# ── Web UI (python -m ui.app) ────────────────────────────────────────────────
# Bind address and port. The UI has no authentication and includes a shell;
# keep it on 127.0.0.1 unless you understand the risk (see SECURITY.md).
# CODING_AGENT_HOST=127.0.0.1
# CODING_AGENT_PORT=8000
# Required to bind to a non-loopback address:
# CODING_AGENT_ALLOW_REMOTE=0
# Extra hostnames accepted in Host/Origin headers (comma-separated), needed
# when the UI is reached through a non-loopback name:
# CODING_AGENT_ALLOWED_HOSTS=
# Restrict which folders can be opened as workspaces (comma-separated):
# ALLOWED_WORKSPACE_ROOTS=/home/me/projects
# Auto-reload the backend on code changes (development only):
# CODING_AGENT_RELOAD=0
